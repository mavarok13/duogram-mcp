{
  "name": "@duogram/desktop",
  "version": "0.1.0",
  "description": "Local-first visual boards for users and agents",
  "homepage": "https://github.com/mavarok13/duogram-mcp",
  "author": "Duogram contributors",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./dist/main/main/main.js",
  "scripts": {
    "build": "tsc --build && vite build",
    "start": "pnpm run build && electron .",
    "typecheck": "tsc --build --pretty false --noEmit"
  },
  "build": {
    "appId": "com.duogram.desktop",
    "productName": "Duogram",
    "directories": {
      "output": "../../release/desktop"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "artifactName": "Duogram-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "identity": null
    },
    "linux": {
      "executableName": "duogram",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "maintainer": "Duogram contributors"
    }
  },
  "dependencies": {
    "@duogram/core": "workspace:*",
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/open-sans": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@fontsource/source-sans-3": "5.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "electron": "44.0.0",
    "electron-builder": "^26.15.3",
    "vite": "8.2.2"
  }
}
