{
  "name": "@duogram/mcp",
  "version": "0.1.0",
  "description": "Duogram CLI and universal stdio MCP server for visual boards",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mavarok13/duogram-mcp.git",
    "directory": "packages/mcp"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "duogram": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --pretty false --noEmit"
  },
  "dependencies": {
    "@duogram/core": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1"
  }
}
