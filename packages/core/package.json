{
  "name": "@duogram/core",
  "version": "0.1.0",
  "description": "Duogram board schemas, operations, and local file storage",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mavarok13/duogram-mcp.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./operations": {
      "types": "./dist/operations.d.ts",
      "default": "./dist/operations.js"
    }
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --pretty false --noEmit"
  },
  "dependencies": {
    "ajv": "8.17.1"
  },
  "devDependencies": {
    "@types/node": "22.20.1"
  }
}
